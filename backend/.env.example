# Cấu hình môi trường - copy file này thành .env và điền giá trị thực

# Secret key cho JWT (đổi thành chuỗi ngẫu nhiên dài)
SECRET_KEY=your-super-secret-key-change-this-in-production

# Thuật toán JWT
ALGORITHM=HS256

# Thời gian hết hạn token (phút)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database URL (SQLite)
DATABASE_URL=sqlite:///./library.db

# Google Gemini API Key
# Lấy tại: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Tên model Gemini
GEMINI_MODEL=gemini-1.5-flash

# Groq API Key (Tốc độ siêu nhanh & hỗ trợ mô hình mã nguồn mở)
# Lấy tại: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=qwen/qwen3.8-27b

# Phạt quá hạn (VNĐ/ngày)
FINE_PER_DAY=2000

# Thời gian mượn mặc định (ngày)
DEFAULT_BORROW_DAYS=14

# Thời gian gia hạn (ngày)
RENEW_DAYS=7

# Số lần gia hạn tối đa
MAX_RENEW_COUNT=1

# Debug mode
DEBUG=True
